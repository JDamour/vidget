{
  "name": "vidget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Detect and save non-DRM video from web pages.",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:e2e": "cross-env VIDGET_E2E=1 wxt build",
    "build:companion": "cross-env VIDGET_COMPANION=1 wxt build",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node tests/fixtures/generate.mjs",
    "e2e": "pnpm build && pnpm build:e2e && pnpm fixtures && playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  },
  "dependencies": {
    "idb": "^8.0.4",
    "lucide-preact": "^1.66.0",
    "m3u8-parser": "^7.2.1",
    "mpd-parser": "^1.4.1",
    "mux.js": "^6.3.0",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
